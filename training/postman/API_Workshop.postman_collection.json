                  "});",
                  "const rows = pm.response.json().data;",
                  "const lines = rows.reduce((n, i) => n + (i.line_items || []).length, 0);",
                  "const postings = rows.reduce((n, i) => n +",
                  "    (i.line_items || []).reduce((m, li) => m + (li.postings || []).length, 0), 0);",
                  "console.log('This response holds: ' + rows.length + ' invoices, ' +",
                  "    lines + ' line items, ' + postings + ' postings');",
